# Copie este arquivo para ".env" na VPS (mesma pasta do docker-compose.yml)
# e preencha com valores reais. NÃO faça commit do .env real.

DATABASE_NAME=nordeste_servicos
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=troque-esta-senha

JWT_SECRET=gere-uma-chave-bem-longa-e-aleatoria-aqui
CORS_ALLOWED_ORIGINS=https://seu-frontend.com

# Google Cloud Storage (opcional, se usar upload de fotos da OS)
GCLOUD_BUCKET=ne-servicos
GCLOUD_CREDENTIALS_B64=
GCLOUD_CREDENTIALS_JSON=
